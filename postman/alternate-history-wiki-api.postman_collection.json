		{
			"name": "tokens",
			"item": [
				{
					"name": "create token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Parse the response JSON",
									"var jsonData = pm.response.json();",
									"",
									"// Check if the token exists",
									"if (jsonData?.data?.token) {",
									"    pm.environment.set(\"ACCESS_TOKEN\", jsonData.data.token);",
									"    console.log(\"ACCESS_TOKEN set:\", jsonData.data.token);",
									"} else {",
									"    console.log(\"Token not found in response\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@alternate-history-wiki.com\",\n    \"password\": \"secret\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{BASE_URL}}/tokens",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
